{
  "name": "school-management-system",
  "version": "1.0.0",
  "description": "School Management System - Desktop Application",
  "main": "electron/main.js",
  "homepage": "./",
  "scripts": {
    "electron": "electron .",
    "electron-dev": "concurrently \"npm run backend-dev\" \"npm run frontend-dev\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "node scripts/build-electron.js",
    "build-frontend": "cd frontend && npm run build",
    "build-backend": "cd backend && npm install",
    "frontend-dev": "cd frontend && npm start",
    "backend-dev": "cd backend && npm run dev",
    "dist": "npm run build && electron-builder",
    "dist-win": "npm run build && electron-builder --win",
    "dist-mac": "npm run build && electron-builder --mac",
    "dist-linux": "npm run build && electron-builder --linux",
    "setup": "npm install && cd frontend && npm install && cd ../backend && npm install"
  },
  "build": {
    "appId": "com.schoolmanagement.app",
    "productName": "School Management System",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "frontend/build/**/*",
      "backend/**/*",
      "!backend/node_modules/**/*",
      "backend/node_modules/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "electron-is-dev": "^2.0.0"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "path": "^0.12.7"
  }
}
